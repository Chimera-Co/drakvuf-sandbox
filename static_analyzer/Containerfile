# CHIMERA static analyzer image.
#   podman build --network=host -t localhost/chimera-static:0.1.0 -f static_analyzer/Containerfile static_analyzer
# --network=host: the default bridge makes netavark put a FORWARD jump above CHIMERA_GUARD, and
# chimera-net-check then (rightly) stops the analysis workers from starting.
# Run only through drakrun/analyzer/static/sandbox.py, which adds --network none, --read-only,
# --cap-drop ALL, no-new-privileges, uid 65534, noexec mounts and resource limits.

# ---- build stage: compilers live here only
FROM docker.io/library/python:3.11-slim-bookworm AS build
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git && rm -rf /var/lib/apt/lists/*
WORKDIR /build
COPY requirements.txt pyproject.toml ./
COPY chimera_static ./chimera_static
RUN pip wheel --wheel-dir /wheels -r requirements.txt && pip wheel --no-deps --wheel-dir /wheels .

# ---- test stage: the analyzer's tests against the exact packages and rules the runtime gets.
#   podman build --network=host --target test -f static_analyzer/Containerfile static_analyzer
# A failing test fails this build. The default build (runtime, below) does not include pytest.
FROM docker.io/library/python:3.11-slim-bookworm AS test
ENV PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CHIMERA_STATIC_YARA=/opt/chimera-static/rules.yarc \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
RUN apt-get update && apt-get install -y --no-install-recommends libmagic1 && rm -rf /var/lib/apt/lists/*
COPY --from=build /wheels /tmp/wheels
RUN pip install --no-index --find-links /tmp/wheels /tmp/wheels/*.whl && pip install pytest==8.3.5
COPY rules /opt/chimera-static/rules
RUN python -I -m chimera_static.rules_build /opt/chimera-static/rules /opt/chimera-static/rules.yarc
COPY rules /src/rules
COPY tests /src/tests
WORKDIR /src
RUN python -m pytest -q -p no:cacheprovider tests

# ---- runtime stage: no compiler, no pip, nothing writable
FROM docker.io/library/python:3.11-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    CHIMERA_STATIC_YARA=/opt/chimera-static/rules.yarc \
    OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends libmagic1 \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /wheels /tmp/wheels
RUN pip install --no-index --find-links /tmp/wheels /tmp/wheels/*.whl \
 && python -I -c "import chimera_static.__main__" \
 && rm -rf /tmp/wheels \
 && pip uninstall -y pip setuptools wheel

# YARA rules baked into the image and compiled here: the build fails on zero rules or a compile error.
# rules.yarc.json records the rule count and each ruleset's pin (rules/<name>/SOURCE.json).
COPY rules /opt/chimera-static/rules
RUN python -I -m chimera_static.rules_build /opt/chimera-static/rules /opt/chimera-static/rules.yarc

USER 65534:65534
WORKDIR /
ENTRYPOINT ["python", "-I", "-m", "chimera_static"]
