+/* CHIMERA-DIAG: map one guest frame directly and report Xen's per-page error. */
+#include <dlfcn.h>
+#include <sys/mman.h>
+typedef void* (*chimera_fm_open_t)(void*, unsigned int);
+typedef void* (*chimera_fm_map_t)(void*, uint32_t, int, size_t, const xen_pfn_t*, int*);
+typedef int (*chimera_fm_unmap_t)(void*, void*, size_t);
+static void chimera_diag_map(drakvuf_t drakvuf, const char* what, addr_t gfn, int prot)
+{
+    static void* fm = NULL;
+    static chimera_fm_map_t fmap = NULL;
+    static chimera_fm_unmap_t funmap = NULL;
+    if (!fm)
+    {
+        chimera_fm_open_t fopen_ = (chimera_fm_open_t)dlsym(RTLD_DEFAULT, "xenforeignmemory_open");
+        fmap = (chimera_fm_map_t)dlsym(RTLD_DEFAULT, "xenforeignmemory_map");
+        funmap = (chimera_fm_unmap_t)dlsym(RTLD_DEFAULT, "xenforeignmemory_unmap");
+        if (fopen_)
+            fm = fopen_(NULL, 0);
+    }
+    if (!fm || !fmap || !funmap)
+    {
+        fprintf(stderr, "CHIMERA-DIAG %s gfn=0x%lx map=unavailable\n", what, gfn);
+        return;
+    }
+    xen_pfn_t pfn = gfn;
+    int err = 0;
+    errno = 0;
+    void* page = fmap(fm, drakvuf->domID, prot, 1, &pfn, &err);
+    int saved_errno = errno;
+    fprintf(stderr, "CHIMERA-DIAG %s gfn=0x%lx prot=%s map=%s err=%d errno=%d\n",
+        what, gfn, prot & PROT_WRITE ? "rw" : "r", page ? "ok" : "FAILED", err, saved_errno);
+    if (page)
+        funmap(fm, page, 1);
+}
+
+static void chimera_diag_fail(drakvuf_t drakvuf, struct memcb_pass* pass, const char* site, addr_t pa)
+{
+    fprintf(stderr, "CHIMERA-DIAG refresh_shadow_copy failed at %s: o=0x%lx r=0x%lx trap_pa=0x%lx write_pa=0x%lx gfn=0x%lx access=0x%x max_gpfn=0x%lx active=%d\n",
+        site, pass->remapped_gfn->o, pass->remapped_gfn->r, pa, pass->pa, pass->gfn,
+        (unsigned)pass->access, (unsigned long)drakvuf->max_gpfn, pass->remapped_gfn->active);
+    chimera_diag_map(drakvuf, "orig", pass->remapped_gfn->o, PROT_READ);
+    chimera_diag_map(drakvuf, "shadow", pass->remapped_gfn->r, PROT_READ | PROT_WRITE);
+    uint8_t probe[VMI_PS_4KB];
+    vmi_pagecache_flush(drakvuf->vmi);
+    fprintf(stderr, "CHIMERA-DIAG after pagecache flush: read orig=%s write shadow-readback=%s\n",
+        VMI_SUCCESS == vmi_read_pa(drakvuf->vmi, pass->remapped_gfn->o << 12, VMI_PS_4KB, probe, NULL) ? "ok" : "FAILED",
+        VMI_SUCCESS == vmi_read_pa(drakvuf->vmi, pass->remapped_gfn->r << 12, VMI_PS_4KB, probe, NULL) ? "ok" : "FAILED");
+}
