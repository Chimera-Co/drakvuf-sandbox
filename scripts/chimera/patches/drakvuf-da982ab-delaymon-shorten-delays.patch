+    : drakvuf{drakvuf}, format{output}, skip_above_ms{skip_above_ms}, skip_to_ms{skip_to_ms}, root_pid{root_pid}
 {
+    if (skip_above_ms && skip_to_ms >= skip_above_ms)
+        throw -1;
+    if (skip_above_ms && !root_pid)
+        fprintf(stderr, PLUGIN_NAME " No injected process: no delay will be shortened.\n");
     register_trap(drakvuf, "NtDelayExecution", &trap, trap_NtDelayExecution_cb);
