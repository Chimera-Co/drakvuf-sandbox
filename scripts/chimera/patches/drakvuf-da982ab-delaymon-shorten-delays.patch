+/*
+ * True if the trapped thread belongs to the injected sample process or one of its descendants,
+ * by walking parent PIDs (at most 16 levels). Positive answers are cached; a process whose
+ * parent has already exited is not recognised.
+ */
+bool delaymon::in_sample_tree(drakvuf_trap_info_t* info)
+{
+    if (!root_pid)
+        return false;
+    vmi_pid_t pid = info->proc_data.pid;
+    vmi_pid_t ppid = info->proc_data.ppid;
+    for (int depth = 0; depth < 16; depth++)
+    {
+        if (pid == root_pid || sample_pids.count(pid))
+        {
+            sample_pids.insert(info->proc_data.pid);
+            return true;
+        }
+        if (ppid <= 4 || ppid == pid)
+            return false;
+        pid = ppid;
+        addr_t process_base;
+        if (!drakvuf_find_process(drakvuf, pid, nullptr, &process_base) ||
+            !drakvuf_get_process_ppid(drakvuf, process_base, &ppid))
+        {
+            // The parent is gone: only its own PID can still tell
+            return pid == root_pid || sample_pids.count(pid);
+        }
+    }
+    return false;
+}
