[Unit]
Description=CHIMERA INetSim (simulated Internet) inside netns chimera-inet
Documentation=file:///home/shreyas/Documents/chimera/chimera-console/docs/chimera/containment-proposal.md
Requires=chimera-net.service
After=chimera-net.service

[Service]
Type=simple
# Network isolation: only the veth to dom0 exists in this namespace, no default route.
NetworkNamespacePath=/run/netns/chimera-inet
# INetSim insists on starting as root and drops each service to user "inetsim".
ExecStart=/usr/bin/inetsim --config=/etc/inetsim/chimera-inetsim.conf \
    --log-dir=/var/log/chimera-inetsim --report-dir=/var/log/chimera-inetsim/report \
    --data-dir=/var/lib/inetsim --pidfile=/run/chimera-inetsim/inetsim.pid
Restart=on-failure
RestartSec=3

# Filesystem/IPC sandboxing: the netns isolates the network, not the rest of the host.
RuntimeDirectory=chimera-inetsim
LogsDirectory=chimera-inetsim chimera-inetsim/report
ReadWritePaths=/var/lib/inetsim
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateIPC=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_UNIX
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID CAP_CHOWN
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
