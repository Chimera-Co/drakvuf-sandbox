[Unit]
Description=CHIMERA static-analysis worker (chimera_static in a locked-down Podman container)
Documentation=file:///opt/chimera/docs/chimera/static-analysis.md
Requires=redis-server.service
After=redis-server.service

[Service]
Type=simple
# The worker only copies samples and launches the container; it never parses a sample itself.
# Root is needed to hand the staged copy to the container's uid (root:65534, mode 0440).
ExecStart=/opt/chimera/venv/bin/drakrun static-worker
Restart=on-failure
RestartSec=10
User=root
UMask=0077
# The worker talks to Redis on localhost and to the local Podman; the analyzer containers
# get --network none. Lock the worker itself down as far as that allows.
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=no
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=3G
TasksMax=256

[Install]
WantedBy=multi-user.target
